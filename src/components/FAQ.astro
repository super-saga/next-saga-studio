---
import type { Translations } from '../i18n/translations'
interface Props { t: Translations }
const { t } = Astro.props
const { kicker, heading, items } = t.faq
---

<section id="faq" class="faq-section">
  <div class="section-wrapper faq-inner">
    <div class="faq-header" data-animate>
      <span class="section-kicker">{kicker}</span>
      <h2 class="faq-h2">{heading}</h2>
    </div>

    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item" data-animate data-animate-delay={String(i * 0.06)}>
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-cta" data-animate>
      <p>Still have questions?</p>
      <a href="#contact" class="faq-link">Send us a message →</a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--color-border);
  }

  .faq-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .faq-inner { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: start; }
    .faq-list  { grid-column: 2; grid-row: 1 / 3; }
    .faq-cta   { grid-column: 1; }
  }

  .faq-h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  /* ── Accordion ── */
  .faq-list { display: grid; gap: 0; }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:first-child { border-top: 1px solid var(--color-border); }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.3rem 0.25rem;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    list-style: none;
    user-select: none;
    transition: color 0.18s;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::marker { display: none; }

  .faq-question:hover { color: var(--color-brand-teal); }

  .faq-icon {
    flex-shrink: 0;
    color: var(--color-text-subtle);
    transition: transform 0.2s, color 0.18s;
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-brand-teal);
  }

  details[open] .faq-question { color: var(--color-brand-teal); }

  .faq-answer {
    overflow: hidden;
    padding: 0 0.25rem 1.3rem;
  }

  .faq-answer p {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 48ch;
  }

  /* ── Footer CTA ── */
  .faq-cta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-cta p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .faq-link {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-brand-teal);
    text-decoration: none;
    transition: opacity 0.18s;
  }

  .faq-link:hover { opacity: 0.72; }
</style>
