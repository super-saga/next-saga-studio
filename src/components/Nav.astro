---
import type { Translations } from '../i18n/translations'
interface Props { t: Translations }
const { t } = Astro.props
const { links, cta, switchLabel, switchHref } = t.nav
const lang = t.lang
---
<header id="site-nav" class="fixed top-0 inset-x-0 z-50">
  <div class="section-wrapper">
    <div class="nav-shell">
      <a href={`/${lang}/`} aria-label="Saga Studio home" class="brand-link">
        <img src="/logo-text-light.jpeg" alt="Saga Studio" height="32" class="h-8 w-auto" />
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        {links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <div class="nav-right">
        <a href={switchHref} class="lang-switch" data-lang={switchLabel.toLowerCase()}>{switchLabel}</a>
        <a href={`/${lang}/#contact`} class="nav-cta hidden md:inline-flex">{cta}</a>
      </div>

      <details class="mobile-nav">
        <summary aria-label="Open menu">Menu</summary>
        <div class="mobile-nav-panel">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href={switchHref} class="lang-switch-mobile" data-lang={switchLabel.toLowerCase()}>{switchLabel}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  #site-nav {
    padding-top: 1rem;
    padding-bottom: 0;
  }

  .nav-shell {
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg-base) 96%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 0.45rem 0.55rem 0.45rem 1.1rem;
    box-shadow: 0 2px 16px color-mix(in srgb, black 7%, transparent), 0 1px 2px color-mix(in srgb, black 5%, transparent);
    margin-inline: 0.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .desktop-nav a {
    border-radius: 999px;
    padding: 0.55rem 0.8rem;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    color: var(--color-text-muted);
  }

  .desktop-nav a:hover {
    background: var(--color-bg-raised);
    color: var(--color-text-primary);
  }

  .nav-right {
    display: none;
    align-items: center;
    gap: 0.4rem;
  }

  .lang-switch {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.5rem 0.8rem;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }

  .lang-switch:hover {
    color: var(--color-brand-teal);
    border-color: var(--color-brand-teal);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    background: var(--color-text-primary);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0.55rem 1.1rem;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .nav-cta:hover { opacity: 0.84; }

  .mobile-nav {
    position: relative;
    display: block;
  }

  .mobile-nav summary {
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-primary);
    font-size: 0.8rem;
    font-weight: 900;
    padding: 0.7rem 0.95rem;
  }

  .mobile-nav summary::-webkit-details-marker { display: none; }

  .mobile-nav-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(78vw, 18rem);
    display: grid;
    gap: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 1.1rem;
    background: var(--color-bg-base);
    box-shadow: 0 8px 32px color-mix(in srgb, black 12%, transparent);
    padding: 0.75rem;
  }

  .mobile-nav-panel a {
    border-radius: 0.85rem;
    color: var(--color-text-primary);
    font-weight: 700;
    padding: 0.85rem;
    text-decoration: none;
  }

  .mobile-nav-panel a:hover { background: var(--color-bg-raised); }

  .lang-switch-mobile {
    border-top: 1px solid var(--color-border);
    margin-top: 0.35rem;
    padding-top: 0.85rem !important;
    color: var(--color-brand-teal) !important;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  @media (min-width: 768px) {
    .desktop-nav { display: flex; }
    .nav-right    { display: flex; }
    .mobile-nav   { display: none; }
  }
</style>

<script>
  // Persist language preference when user clicks a lang switcher
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach(el => {
    el.addEventListener('click', () => {
      const lang = el.dataset.lang
      if (lang === 'en' || lang === 'id') localStorage.setItem('saga-lang', lang)
    })
  })
</script>
