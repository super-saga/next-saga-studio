---
import type { Translations } from '../i18n/translations'
import { SAGA_WA } from '../config'
interface Props { t: Translations }
const { t } = Astro.props
const { kicker, heading, copy, fields, placeholders, servicePrompt, services, button, sending, privacy, successTitle, successBody, whatsappCta, whatsappNote, whatsappMsg } = t.contact

const waUrl = `https://wa.me/${SAGA_WA}?text=${encodeURIComponent(whatsappMsg)}`
---
<section id="contact" class="contact-section">
  <div class="section-wrapper">
    <div class="contact-layout">
      <div data-animate>
        <span class="section-kicker">{kicker}</span>
        <h2 class="section-heading">{heading}</h2>
        <p class="section-copy contact-copy">{copy}</p>

        <div class="contact-details">
          <a href="mailto:studio@saga.co.id" class="contact-detail-item">
            <svg class="cd-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m2 7 10 7 10-7"/>
            </svg>
            studio@saga.co.id
          </a>

          <a href="https://instagram.com/saga.tekno" target="_blank" rel="noopener noreferrer" class="contact-detail-item">
            <svg class="cd-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4.5"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
            @saga.tekno
          </a>

          <a href="https://threads.net/@saga.tekno" target="_blank" rel="noopener noreferrer" class="contact-detail-item">
            <svg class="cd-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.028-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.592 12c.024 3.086.715 5.496 2.053 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.689-2.047 1.203-1.282 1.514-2.979 1.488-4.23-.022-1.097-.287-2.022-.776-2.748-.372-.545-.888-.98-1.511-1.29-.224 1.956-.85 3.552-1.877 4.748-1.27 1.476-3.042 2.253-5.274 2.311-1.701.046-3.32-.43-4.441-1.311-1.244-.97-1.941-2.39-1.965-4.013-.022-1.56.598-2.985 1.747-4.012 1.184-1.06 2.864-1.646 4.723-1.652h.063c1.344.006 2.574.326 3.57.926.88.535 1.561 1.292 2.013 2.22.534-.323 1.24-.504 2.128-.504 1.714 0 3.082.602 4.06 1.788.848 1.021 1.322 2.454 1.353 4.084.04 2.102-.464 4.556-2.317 6.534C17.566 23.059 15.222 23.98 12.186 24zm-2.8-8.764c.776 0 1.449-.194 1.947-.559.67-.486 1.02-1.272 1.064-2.34a6.263 6.263 0 0 0-1.598-.213h-.047c-1.104.006-2.057.336-2.69.929-.551.516-.836 1.195-.82 1.954.014.696.336 1.268.923 1.654.512.339 1.18.52 1.928.52l.293-.945z"/>
            </svg>
            @saga.tekno
          </a>
        </div>
      </div>

      <div class="contact-form" data-animate data-animate-delay="0.12">
        <form id="contact-form" action="#" method="POST" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="name">{fields.name} *</label>
              <input id="name" name="name" type="text" required placeholder={placeholders.name} />
            </div>

            <div class="field">
              <label for="email">{fields.email} *</label>
              <input id="email" name="email" type="email" required placeholder={placeholders.email} />
            </div>

            <div class="field">
              <label for="phone">{fields.phone}</label>
              <input id="phone" name="phone" type="tel" placeholder={placeholders.phone} />
            </div>

            <div class="field">
              <label for="service">{fields.service} *</label>
              <select id="service" name="service" required>
                <option value="" disabled selected>{servicePrompt}</option>
                {services.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>

            <div class="field field--full">
              <label for="message">{fields.message} *</label>
              <textarea id="message" name="message" required rows="5" placeholder={placeholders.message}></textarea>
            </div>
          </div>

          <button type="submit" id="contact-submit" class="gradient-btn">{button}</button>
          <p class="privacy-note">{privacy}</p>
        </form>

        <!-- Success state -->
        <div id="contact-success" class="contact-success" hidden>
          <div class="cs-icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3 class="cs-title">{successTitle}</h3>
          <p class="cs-body">{successBody}</p>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="gradient-btn cs-wa-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
            </svg>
            {whatsappCta}
          </a>
          <p class="cs-note">{whatsappNote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 75% 20%, color-mix(in srgb, var(--color-brand-teal) 6%, transparent), transparent 26rem),
      var(--color-bg-base);
  }

  .contact-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .contact-copy {
    max-width: 37rem;
    margin-top: 1.2rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .contact-detail-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-subtle);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
    width: fit-content;
  }

  .contact-detail-item:hover { color: var(--color-text-muted); }

  .cd-icon {
    flex-shrink: 0;
    opacity: 0.45;
  }

  .contact-form {
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-bg-surface);
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  form {
    display: contents;
  }

  .form-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field--full { grid-column: span 2; }
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  label {
    color: var(--color-text-primary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  input, select, textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.9rem;
    outline: none;
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    padding: 0.85rem 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  textarea { resize: vertical; min-height: 9rem; }

  input::placeholder, textarea::placeholder { color: var(--color-text-subtle); }

  input:focus, select:focus, textarea:focus {
    border-color: var(--color-brand-teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand-teal) 12%, transparent);
  }

  select option { background: var(--color-bg-base); color: var(--color-text-primary); }

  #contact-submit {
    display: block;
    width: 100%;
    margin-top: 1.2rem;
    border: 0;
    cursor: pointer;
  }

  .privacy-note {
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
    text-align: center;
  }

  @media (min-width: 980px) {
    .contact-layout { grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr); }
  }

  /* ── Success state ── */
  .contact-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 2rem 0;
    animation: csIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
  }

  @keyframes csIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cs-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-brand-teal) 12%, transparent);
    color: var(--color-brand-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  .cs-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .cs-body {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 30ch;
  }

  .cs-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    margin-top: 0.25rem;
    font-size: 0.92rem;
  }

  .cs-note {
    font-size: 0.78rem;
    color: var(--color-text-subtle);
    margin: 0;
  }
</style>

<script define:vars={{ sendingLabel: sending, lang: t.lang }}>
  const form = document.getElementById('contact-form')
  const submitBtn = document.getElementById('contact-submit')
  const successEl = document.getElementById('contact-success')
  let submitted = false

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (submitted) return
    if (!form.checkValidity()) { form.reportValidity(); return }

    submitted = true
    submitBtn.disabled = true
    submitBtn.textContent = sendingLabel

    const fd = new FormData(form)
    const sender = window.__sagaSendToSlack
    if (typeof sender === 'function') {
      await sender({
        name:    String(fd.get('name') || ''),
        email:   String(fd.get('email') || ''),
        phone:   String(fd.get('phone') || ''),
        service: String(fd.get('service') || ''),
        message: String(fd.get('message') || ''),
        source:  'Contact Form (' + lang + ')',
      })
    }

    form.hidden = true
    successEl.hidden = false
  })
</script>
