---
import type { Translations } from '../i18n/translations'
import { SAGA_WA } from '../config'
interface Props { t: Translations }
const { t } = Astro.props
const c = t.chat
const WEBHOOK = import.meta.env.SLACK_WEBHOOK_URL ?? ''
const waUrl = `https://wa.me/${SAGA_WA}?text=${encodeURIComponent(c.whatsappMsg)}`
---

<!-- FAB -->
<button id="chat-fab" aria-label={c.fabLabel} aria-expanded="false" aria-controls="chat-sheet">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
  </svg>
  <span class="fab-badge" id="fab-badge" aria-hidden="true">1</span>
</button>

<!-- Sheet -->
<div id="chat-sheet" role="dialog" aria-modal="true" aria-label={c.headerTitle} aria-hidden="true">
  <div class="sheet-header">
    <div class="sheet-brand">
      <!-- S mark (gradient svg, no image dependency) -->
      <svg width="22" height="22" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="cg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#2ABFB3"/>
            <stop offset="100%" stop-color="#CAEF6F"/>
          </linearGradient>
        </defs>
        <rect x="6" y="4" width="22" height="10" rx="4" fill="url(#cg)"/>
        <rect x="12" y="15" width="22" height="10" rx="4" fill="url(#cg)" opacity="0.85"/>
        <rect x="6" y="26" width="22" height="10" rx="4" fill="url(#cg)" opacity="0.7"/>
      </svg>
      <span class="brand-name">{c.headerTitle}</span>
      <span class="online-dot" aria-hidden="true"></span>
    </div>
    <button class="sheet-close" id="chat-close" aria-label="Close chat">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="sheet-status">{c.headerStatus}</div>

  <!-- Form view -->
  <div id="chat-form-view" class="sheet-body">
    <div class="chat-bubble">{c.intro}</div>

    <form id="chat-form" novalidate>
      <div class="chat-field">
        <label for="cf-name">{c.fields.name} *</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="chat-field">
        <label for="cf-email">{c.fields.email} *</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="chat-field">
        <label for="cf-phone">{c.fields.phone}</label>
        <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="chat-field">
        <label for="cf-service">{c.fields.service} *</label>
        <select id="cf-service" name="service" required>
          <option value="" disabled selected>{c.servicePrompt}</option>
          {c.services.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div class="chat-field">
        <label for="cf-message">{c.fields.message} *</label>
        <textarea id="cf-message" name="message" required rows="3" placeholder={c.placeholder.message}></textarea>
      </div>
      <button type="submit" id="chat-submit" class="chat-send-btn">
        <span id="chat-btn-text">{c.button}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>

  <!-- Success view -->
  <div id="chat-success-view" class="sheet-body sheet-body--success" hidden>
    <div class="success-icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <h3 id="success-title">{c.successTitle}</h3>
    <p id="success-body">{c.successBody}</p>

    <!-- WhatsApp CTA -->
    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="chat-send-btn chat-wa-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
      </svg>
      {c.whatsappCta}
    </a>

    <button id="chat-success-close" class="chat-send-btn chat-send-btn--outline">{c.successCta}</button>
  </div>
</div>

<!-- Backdrop -->
<div id="chat-backdrop" aria-hidden="true"></div>

<style>
  /* ── FAB ── */
  #chat-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 900;
    width: 3.5rem;
    height: 3.5rem;
    border: none;
    border-radius: 50%;
    background: linear-gradient(135deg, #1A9E93, #CAEF6F);
    color: #0C1410;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 28px color-mix(in srgb, #1A9E93 40%, transparent), 0 2px 8px rgba(0,0,0,0.15);
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.2s;
  }

  #chat-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 40px color-mix(in srgb, #1A9E93 50%, transparent), 0 4px 12px rgba(0,0,0,0.15);
  }

  #chat-fab[aria-expanded="true"] {
    background: #0C1410;
    color: #fff;
    transform: scale(1);
  }

  .fab-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #e53e3e;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    animation: badgePop 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
  }

  .fab-badge[hidden] { display: none; }

  @keyframes badgePop {
    from { transform: scale(0); }
    to   { transform: scale(1); }
  }

  /* ── Sheet ── */
  #chat-sheet {
    position: fixed;
    bottom: 5.5rem;
    right: 1.5rem;
    z-index: 901;
    width: min(380px, calc(100vw - 2rem));
    max-height: calc(100vh - 7rem);
    border-radius: 1.5rem;
    background: #fff;
    border: 1px solid #D4D8CE;
    box-shadow: 0 24px 80px rgba(0,0,0,0.14), 0 4px 16px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* animate in/out */
    transform-origin: bottom right;
    transform: scale(0.85) translateY(16px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.28s cubic-bezier(0.34,1.56,0.64,1), opacity 0.2s ease;
  }

  #chat-sheet.is-open {
    transform: scale(1) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Header ── */
  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1rem 0.75rem;
    border-bottom: 1px solid #D4D8CE;
    background: #0C1410;
    flex-shrink: 0;
  }

  .sheet-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-name {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .online-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 2px rgba(74,222,128,0.3);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,100% { box-shadow: 0 0 0 2px rgba(74,222,128,0.3); }
    50%      { box-shadow: 0 0 0 5px rgba(74,222,128,0.1); }
  }

  .sheet-close {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.6);
    padding: 0.25rem;
    border-radius: 0.4rem;
    display: flex;
    transition: color 0.15s;
  }

  .sheet-close:hover { color: #fff; }

  /* ── Status bar ── */
  .sheet-status {
    background: color-mix(in srgb, #1A9E93 10%, #fff);
    color: #1A9E93;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #D4D8CE;
    flex-shrink: 0;
  }

  /* ── Body ── */
  .sheet-body {
    padding: 1rem;
    overflow-y: auto;
    flex: 1;
  }

  .sheet-body--success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    padding: 2rem 1.5rem;
  }

  /* ── Chat bubble ── */
  .chat-bubble {
    background: #F5F6F3;
    border-radius: 0 1rem 1rem 1rem;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #0C1410;
    margin-bottom: 1.1rem;
    max-width: 90%;
  }

  /* ── Form fields ── */
  #chat-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .chat-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .chat-field label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4D6052;
  }

  .chat-field input,
  .chat-field select,
  .chat-field textarea {
    width: 100%;
    border: 1px solid #D4D8CE;
    border-radius: 0.65rem;
    padding: 0.65rem 0.8rem;
    font-size: 0.9rem;
    font-family: inherit;
    background: #fff;
    color: #0C1410;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .chat-field textarea { resize: none; min-height: 5rem; }

  .chat-field input::placeholder,
  .chat-field textarea::placeholder { color: #7A9280; }

  .chat-field input:focus,
  .chat-field select:focus,
  .chat-field textarea:focus {
    border-color: #1A9E93;
    box-shadow: 0 0 0 3px color-mix(in srgb, #1A9E93 12%, transparent);
  }

  .chat-field input.invalid,
  .chat-field select.invalid,
  .chat-field textarea.invalid {
    border-color: #e53e3e;
    box-shadow: 0 0 0 3px rgba(229,62,62,0.1);
  }

  /* ── Send button ── */
  .chat-send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.85rem 1.2rem;
    border: none;
    border-radius: 0.85rem;
    background: linear-gradient(135deg, #1A9E93, #CAEF6F);
    color: #0C1410;
    font-size: 0.9rem;
    font-weight: 800;
    font-family: inherit;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }

  .chat-send-btn:hover { opacity: 0.9; transform: translateY(-1px); }
  .chat-send-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .chat-send-btn--outline {
    background: none;
    border: 1px solid #D4D8CE;
    color: #4D6052;
    margin-top: 0;
  }

  .chat-send-btn--outline:hover {
    border-color: #1A9E93;
    color: #1A9E93;
    opacity: 1;
    transform: none;
  }

  .chat-wa-link {
    background: #25D366;
    color: #fff;
    margin-top: 0;
    text-decoration: none;
  }

  .chat-wa-link:hover { opacity: 0.88; transform: translateY(-1px); }

  /* ── Success state ── */
  .success-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: color-mix(in srgb, #1A9E93 12%, transparent);
    color: #1A9E93;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: successPop 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
  }

  @keyframes successPop {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  #success-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0C1410;
    margin: 0;
  }

  #success-body {
    font-size: 0.9rem;
    line-height: 1.65;
    color: #4D6052;
    margin: 0;
    max-width: 26ch;
  }

  /* ── Backdrop (mobile) ── */
  #chat-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 899;
    background: rgba(0,0,0,0.35);
    opacity: 0;
    transition: opacity 0.2s;
  }

  #chat-backdrop.is-open {
    opacity: 1;
  }

  @media (max-width: 480px) {
    #chat-sheet {
      bottom: 0;
      right: 0;
      width: 100%;
      max-height: 88vh;
      border-radius: 1.5rem 1.5rem 0 0;
      transform-origin: bottom center;
    }
    #chat-fab {
      bottom: 1rem;
      right: 1rem;
    }
    #chat-backdrop { display: block; }
  }
</style>

<script define:vars={{ WEBHOOK, successTitle: c.successTitle, successBody: c.successBody, sendingLabel: c.sending, lang: t.lang }}>
  const fab      = document.getElementById('chat-fab')
  const sheet    = document.getElementById('chat-sheet')
  const backdrop = document.getElementById('chat-backdrop')
  const closeBtn = document.getElementById('chat-close')
  const badge    = document.getElementById('fab-badge')
  const form     = document.getElementById('chat-form')
  const submitBtn = document.getElementById('chat-submit')
  const btnText  = document.getElementById('chat-btn-text')
  const formView    = document.getElementById('chat-form-view')
  const successView = document.getElementById('chat-success-view')
  const successClose = document.getElementById('chat-success-close')

  function openChat() {
    sheet.classList.add('is-open')
    backdrop.classList.add('is-open')
    fab.setAttribute('aria-expanded', 'true')
    sheet.removeAttribute('aria-hidden')
    badge.hidden = true
    document.getElementById('cf-name').focus()
  }

  function closeChat() {
    sheet.classList.remove('is-open')
    backdrop.classList.remove('is-open')
    fab.setAttribute('aria-expanded', 'false')
    sheet.setAttribute('aria-hidden', 'true')
    fab.focus()
  }

  fab.addEventListener('click', () => {
    const isOpen = fab.getAttribute('aria-expanded') === 'true'
    isOpen ? closeChat() : openChat()
  })

  closeBtn.addEventListener('click', closeChat)
  backdrop.addEventListener('click', closeChat)
  successClose.addEventListener('click', closeChat)

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fab.getAttribute('aria-expanded') === 'true') closeChat()
  })

  /* ── Validation ── */
  function validateField(el) {
    const ok = el.checkValidity()
    el.classList.toggle('invalid', !ok)
    return ok
  }

  form.querySelectorAll('input,select,textarea').forEach(el => {
    el.addEventListener('blur', () => validateField(el))
    el.addEventListener('input', () => el.classList.remove('invalid'))
  })

  /* ── Slack submission ── */
  async function sendToSlack(data) {
    const blocks = [
      {
        type: 'header',
        text: { type: 'plain_text', text: '🔔 New Lead — Saga Studio (' + lang.toUpperCase() + ')' }
      },
      {
        type: 'section',
        fields: [
          { type: 'mrkdwn', text: '*Name:*\n' + data.name },
          { type: 'mrkdwn', text: '*Email:*\n' + data.email },
          { type: 'mrkdwn', text: '*WhatsApp:*\n' + (data.phone || '—') },
          { type: 'mrkdwn', text: '*Service:*\n' + (data.service || '—') },
        ]
      },
      {
        type: 'section',
        text: { type: 'mrkdwn', text: '*Message:*\n' + data.message }
      },
      {
        type: 'context',
        elements: [{ type: 'mrkdwn', text: 'Source: ' + data.source + ' | ' + new Date().toUTCString() }]
      }
    ]

    await fetch(WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ blocks }),
      mode: 'no-cors',
    })
  }

  /* ── Chat form submit ── */
  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    let valid = true
    form.querySelectorAll('[required]').forEach(el => {
      if (!validateField(el)) valid = false
    })
    if (!valid) return

    submitBtn.disabled = true
    btnText.textContent = sendingLabel

    const fd = new FormData(form)
    await sendToSlack({
      name:    fd.get('name'),
      email:   fd.get('email'),
      phone:   fd.get('phone'),
      service: fd.get('service'),
      message: fd.get('message'),
      source:  'Floating Chat',
    })

    formView.hidden = true
    successView.hidden = false
  })

  /* ── Expose sendToSlack for the main contact form ── */
  window.__sagaSendToSlack = sendToSlack
</script>
