---
import type { Translations } from '../i18n/translations'
interface Props { t: Translations }
const { t } = Astro.props
const { kicker, heading, subheading, viewLabel, projects } = t.portfolio
const lang = t.lang

function parseHeading(h: string) {
  const m = h.match(/^(.*?)\{(.+?)\}(.*)$/)
  if (!m) return { before: h, hi: '', after: '' }
  return { before: m[1], hi: m[2], after: m[3] }
}
const { before, hi, after } = parseHeading(heading)
---

<section id="portfolio" class="portfolio-section">
  <div class="section-wrapper">
    <div class="portfolio-header" data-animate>
      <span class="section-kicker">{kicker}</span>
      <h2 class="portfolio-h2">
        {before}<span class="portfolio-hi">{hi}</span>{after}
      </h2>
      <p class="portfolio-sub">{subheading}</p>
    </div>
  </div>

  <!-- Full-bleed horizontal scroll track -->
  <div class="projects-scroll-outer" id="portfolio-scroll">
    <div class="projects-scroll" id="portfolio-track">
      {projects.map((p) => (
        <a href={`/${lang}/portfolio/${p.slug}/`} class="project-card">
          <div class="card-image-wrap">
            <img src={p.image} alt={p.name} loading="lazy" class="card-image" />
            <div class="card-overlay">
              <span class="card-cta">{viewLabel} →</span>
            </div>
          </div>
          <div class="card-body">
            <span class="card-tag">{p.tag}</span>
            <h3 class="card-name">{p.name}</h3>
            <p class="card-desc">{p.desc}</p>
          </div>
        </a>
      ))}

      <!-- CTA card — last item in the scroll -->
      <a href={`/${lang}/#contact`} class="project-card cta-card">
        <div class="cta-card-inner">
          <span class="cta-card-eyebrow">Ready to build?</span>
          <h3 class="cta-card-h">Start a project with Saga Studio</h3>
          <p class="cta-card-p">Tell us about your build. We respond with a concrete next step within one business day.</p>
          <span class="cta-card-btn">Get in touch →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .portfolio-section {
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .portfolio-header { max-width: 52rem; margin-bottom: clamp(2rem, 4vw, 3rem); }

  .portfolio-h2 {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .portfolio-hi { color: var(--color-brand-teal); }

  .portfolio-sub {
    margin-top: 0.9rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 38rem;
  }

  /* ── Horizontal scroll track ── */
  .projects-scroll-outer {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 0.75rem 1.75rem;
    /* left edge aligns with section-wrapper content */
    padding-left: max(1.5rem, calc((100vw - 1200px) / 2 + 2rem));
    padding-right: max(1.5rem, calc((100vw - 1200px) / 2 + 2rem));
    cursor: grab;
  }

  .projects-scroll-outer:active { cursor: grabbing; }
  .projects-scroll-outer::-webkit-scrollbar { display: none; }

  .projects-scroll {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    will-change: transform;
  }

  /* ── Project card ── */
  .project-card {
    flex-shrink: 0;
    width: clamp(260px, 72vw, 340px);
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    overflow: hidden;
    transition: box-shadow 0.22s, transform 0.22s;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    user-select: none;
  }

  @media (min-width: 640px)  { .project-card { width: clamp(300px, 38vw, 360px); } }
  @media (min-width: 1000px) { .project-card { width: 340px; } }

  .project-card:hover {
    box-shadow: 0 12px 36px color-mix(in srgb, black 13%, transparent);
    transform: translateY(-4px);
  }

  /* Image */
  .card-image-wrap {
    position: relative;
    height: 210px;
    overflow: hidden;
    background: var(--color-bg-raised);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
    display: block;
  }

  .project-card:hover .card-image { transform: scale(1.04); }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, #0C1410 55%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .project-card:hover .card-overlay { opacity: 1; }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #fff;
    color: var(--color-text-primary);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    transition: background 0.18s;
  }

  .card-cta:hover { background: var(--color-brand-lime); }

  /* Body */
  .card-body { padding: 1.3rem 1.5rem 1.5rem; flex: 1; }

  .card-tag {
    display: inline-block;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-brand-teal) 12%, transparent);
    color: var(--color-brand-teal);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.28rem 0.7rem;
  }

  .card-name {
    margin-top: 0.7rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .card-desc {
    margin-top: 0.45rem;
    font-size: 0.83rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* ── CTA card ── */
  .cta-card {
    background: linear-gradient(135deg, #0f7a6f 0%, #1a9e43 60%, #a8cc3a 100%);
    border-color: transparent;
    justify-content: center;
  }

  .cta-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px color-mix(in srgb, #2ABFB3 28%, transparent);
  }

  .cta-card-inner {
    padding: 2rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
    justify-content: center;
  }

  .cta-card-eyebrow {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }

  .cta-card-h {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #fff;
    margin: 0;
  }

  .cta-card-p {
    font-size: 0.84rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.8);
    margin: 0;
  }

  .cta-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.35);
    color: #fff;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.6rem 1.2rem;
    width: fit-content;
    transition: background 0.18s;
  }

  .cta-card:hover .cta-card-btn { background: rgba(255,255,255,0.3); }
</style>

<script>
  const outer = document.getElementById('portfolio-scroll')
  const track = document.getElementById('portfolio-track')
  if (outer && track) {
    // Duplicate items for seamless loop
    const originalItems = Array.from(track.children) as HTMLElement[]
    originalItems.forEach(el => {
      const clone = el.cloneNode(true) as HTMLElement
      clone.setAttribute('aria-hidden', 'true')
      clone.setAttribute('tabindex', '-1')
      track.appendChild(clone)
    })

    const originalWidth = () => {
      let w = 0
      const gap = 20
      originalItems.forEach(el => { w += el.offsetWidth + gap })
      return w
    }

    let scrollPos = 0
    let speed = 0.55 // px per frame (~33px/s at 60fps)
    let paused = false
    let dragStartX = 0
    let dragStartScroll = 0
    let isDragging = false

    function step() {
      if (!paused && !isDragging) {
        scrollPos += speed
        const ow = originalWidth()
        if (scrollPos >= ow) scrollPos -= ow
        outer.scrollLeft = scrollPos
      }
      requestAnimationFrame(step)
    }

    // Pause on hover
    outer.addEventListener('mouseenter', () => { paused = true })
    outer.addEventListener('mouseleave', () => { paused = false })

    // Pause on touch
    outer.addEventListener('touchstart', () => { paused = true }, { passive: true })
    outer.addEventListener('touchend', () => {
      setTimeout(() => { paused = false }, 2500)
    }, { passive: true })

    // Drag to scroll
    outer.addEventListener('mousedown', (e: MouseEvent) => {
      isDragging = true
      dragStartX = e.pageX
      dragStartScroll = outer.scrollLeft
      scrollPos = outer.scrollLeft
    })
    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return
      const dx = dragStartX - e.pageX
      let next = dragStartScroll + dx
      const ow = originalWidth()
      if (next < 0) next += ow
      if (next >= ow) next -= ow
      outer.scrollLeft = next
      scrollPos = next
    })
    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false
        setTimeout(() => { paused = false }, 1500)
      }
    })

    requestAnimationFrame(step)
  }
</script>
