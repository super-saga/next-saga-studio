---
import type { Translations } from '../i18n/translations'
interface Props { t: Translations }
const { t } = Astro.props
const { kicker, heading, items } = t.whySaga
---
<section id="about" class="why-section">
  <div class="section-wrapper">
    <div class="why-layout">
      <div data-animate>
        <span class="section-kicker">{kicker}</span>
        <h2 class="section-heading">{heading}</h2>
      </div>

      <div class="why-list">
        {items.map((item, i) => (
          <article data-animate data-animate-delay={String(i * 0.08)}>
            <span>0{i + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .why-section { padding-block: clamp(5rem, 10vw, 8rem); }

  .why-layout {
    display: grid;
    gap: 2.5rem;
  }

  .why-list { border-top: 1px solid var(--color-border); }

  .why-list article {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-block: 1.5rem;
  }

  .why-list span {
    color: var(--color-brand-teal);
    font-weight: 900;
  }

  .why-list h3 {
    color: var(--color-text-primary);
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: -0.05em;
  }

  .why-list p {
    max-width: 40rem;
    margin-top: 0.55rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (min-width: 900px) {
    .why-layout { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  }
</style>
