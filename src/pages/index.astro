---
// Root redirect — detects Indonesian IP → /id/, everything else → /en/
// Preference stored in localStorage so manual switches persist.
---
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Saga Studio — AI & Product Engineering Studio</title>
  <meta name="description" content="Saga Studio helps founders and operating teams build production-grade product, AI, and platform systems in Southeast Asia." />

  <!-- Open Graph — crawlers (WhatsApp, Telegram, iMessage, etc.) land here first -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Saga Studio" />
  <meta property="og:title" content="Saga Studio — AI & Product Engineering Studio" />
  <meta property="og:description" content="Saga Studio helps founders and operating teams build production-grade product, AI, and platform systems in Southeast Asia." />
  <meta property="og:url" content="https://studio.saga.co.id/" />
  <meta property="og:image" content="https://studio.saga.co.id/og-image.png" />
  <meta property="og:image:secure_url" content="https://studio.saga.co.id/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="Saga Studio — AI & Product Engineering Studio" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Saga Studio — AI & Product Engineering Studio" />
  <meta name="twitter:description" content="Saga Studio helps founders and operating teams build production-grade product, AI, and platform systems in Southeast Asia." />
  <meta name="twitter:image" content="https://studio.saga.co.id/og-image.png" />

  <link rel="canonical" href="https://studio.saga.co.id/en/" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <style>
    html, body { margin: 0; background: #fff; }
    .loader {
      position: fixed; inset: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: #1A9E93;
      animation: pulse 1s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:0.2} 50%{opacity:1} }
  </style>
</head>
<body>
  <div class="loader" aria-hidden="true"><div class="dot"></div></div>
  <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>

  <script>
    (function () {
      // 1. Honour explicit user preference (set when they click EN/ID switcher)
      var saved = localStorage.getItem('saga-lang')
      if (saved === 'id' || saved === 'en') {
        location.replace('/' + saved + '/')
        return
      }

      // 2. IP-based detection via Cloudflare trace — fast, no API key, no CORS
      fetch('https://www.cloudflare.com/cdn-cgi/trace', { cache: 'no-store' })
        .then(function (r) { return r.text() })
        .then(function (text) {
          var match = text.match(/^loc=(.+)$/m)
          var country = match ? match[1].trim() : ''
          var lang = country === 'ID' ? 'id' : 'en'
          localStorage.setItem('saga-lang', lang)
          location.replace('/' + lang + '/')
        })
        .catch(function () {
          // 3. Fallback: browser language
          var lang = (navigator.language || '').toLowerCase().startsWith('id') ? 'id' : 'en'
          location.replace('/' + lang + '/')
        })
    })()
  </script>
</body>
</html>
